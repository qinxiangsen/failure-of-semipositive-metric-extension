import FailureOfSemipositiveMetricExtension.ProjectivePlaneMaps
import FailureOfSemipositiveMetricExtension.ProjectiveLineMaps

/-! The actual one-point projective incidence surface for the blowup of
`P²` at `[1:0:0]`. Unlike the four-centre family elsewhere in the project,
this space has one projective direction, and its ruling charts are proved
from the quotient definitions, with no product assumption. -/
namespace FailureOfSemipositiveMetricExtension.Hisamoto
noncomputable section
open Set

abbrev PlanePoint := ProjectivePlane.Point
abbrev Direction := ProjectiveLine.Point

/-- The ideal of `[1:0:0]` is generated by the last two coordinates. -/
def centrePair : (Fin 3 → ℂ) →ₗ[ℂ] (Fin 2 → ℂ) where
  toFun v := ![v 1,v 2]
  map_add' _ _ := by ext i; fin_cases i <;> rfl
  map_smul' _ _ := by ext i; fin_cases i <;> rfl

/-- Intrinsic one-point incidence; independent of chosen homogeneous representatives. -/
def Incidence (p : PlanePoint) (d : Direction) : Prop :=
  p.submodule ≤ d.submodule.comap centrePair

/-- One plane point and one ruling direction, rather than four blowup centres. -/
def Point := {q : PlanePoint × Direction // Incidence q.1 q.2}

def blowdown (q : Point) : PlanePoint := q.val.1
def ruling (q : Point) : Direction := q.val.2

@[ext] theorem point_ext {q q' : Point} (hp : blowdown q = blowdown q')
    (hd : ruling q = ruling q') : q = q' := Subtype.ext (Prod.ext hp hd)

theorem incidence_mk_iff (v : Fin 3 → ℂ) (hv : v ≠ 0) (d : Direction) :
    Incidence (Projectivization.mk ℂ v hv) d ↔ centrePair v ∈ d.submodule := by
  unfold Incidence
  rw [Projectivization.submodule_mk,Submodule.span_singleton_le_iff_mem]
  rfl

def directionVector (i : Fin 2) (t : ℂ) : Fin 2 → ℂ :=
  if i = 0 then Blowup.vectorX t else Blowup.vectorY t

@[simp] theorem directionVector_self (i : Fin 2) (t : ℂ) : directionVector i t i = 1 := by
  fin_cases i <;> simp [directionVector,Blowup.vectorX,Blowup.vectorY]

theorem directionVector_ne_zero (i : Fin 2) (t : ℂ) : directionVector i t ≠ 0 := by
  intro h
  have h' := congrFun h i
  simpa using h'

@[simp] theorem directionVector_mk (i : Fin 2) (t : ℂ) :
    Projectivization.mk ℂ (directionVector i t) (directionVector_ne_zero i t) =
      ProjectiveLine.param i t := by
  fin_cases i <;> rfl

/-- Linear embedding `[x:s] ↦ [x:s*d₀:s*d₁]` over a normalized base direction. -/
def fiberLinear (i : Fin 2) (t : ℂ) : (Fin 2 → ℂ) →ₗ[ℂ] (Fin 3 → ℂ) where
  toFun v := ![v 0,v 1 * directionVector i t 0,v 1 * directionVector i t 1]
  map_add' v w := by ext j; fin_cases j <;> simp <;> ring
  map_smul' c v := by ext j; fin_cases j <;> simp <;> ring

theorem fiberLinear_injective (i : Fin 2) (t : ℂ) : Function.Injective (fiberLinear i t) := by
  intro v w h
  have h0 := congrFun h 0
  have h1 : v 1 = w 1 := by
    fin_cases i
    · simpa [fiberLinear,directionVector,Blowup.vectorX] using congrFun h 1
    · simpa [fiberLinear,directionVector,Blowup.vectorY] using congrFun h 2
  ext j
  fin_cases j
  · exact h0
  · exact h1

/-- Actual morphism of projective quotient sets, induced by an injective linear map. -/
def fiberPlane (i : Fin 2) (t : ℂ) : Direction → PlanePoint :=
  Projectivization.map (fiberLinear i t) (fiberLinear_injective i t)

theorem fiberPlane_injective (i : Fin 2) (t : ℂ) : Function.Injective (fiberPlane i t) :=
  Projectivization.map_injective (fiberLinear i t) (fiberLinear_injective i t)

theorem fiberPlane_incidence (i : Fin 2) (t : ℂ) (p : Direction) :
    Incidence (fiberPlane i t p) (ProjectiveLine.param i t) := by
  induction p using Projectivization.ind with
  | h v hv =>
    rw [fiberPlane,Projectivization.map_mk,incidence_mk_iff,← directionVector_mk i t,
      Projectivization.submodule_mk,Submodule.mem_span_singleton]
    refine ⟨v 1,?_⟩
    ext j
    fin_cases j <;> simp [centrePair,fiberLinear,smul_eq_mul]

/-- The product parametrization is constructed inside the actual incidence locus. -/
def localParam (i : Fin 2) (q : Direction × ℂ) : Point :=
  ⟨(fiberPlane i q.2 q.1,ProjectiveLine.param i q.2),fiberPlane_incidence i q.2 q.1⟩

@[simp] theorem blowdown_localParam (i : Fin 2) (q : Direction × ℂ) :
    blowdown (localParam i q) = fiberPlane i q.2 q.1 := rfl
@[simp] theorem ruling_localParam (i : Fin 2) (q : Direction × ℂ) :
    ruling (localParam i q) = ProjectiveLine.param i q.2 := rfl

theorem localParam_injective (i : Fin 2) : Function.Injective (localParam i) := by
  rintro ⟨p,t⟩ ⟨p',t'⟩ h
  have ht := ProjectiveLine.param_injective i (congrArg ruling h)
  dsimp at ht
  subst t'
  exact Prod.ext (fiberPlane_injective i t (congrArg blowdown h)) rfl

/-- Surjectivity is proved using the incidence equation, not stipulated. -/
theorem exists_fiberPlane_of_incidence (i : Fin 2) (t : ℂ) (p : PlanePoint)
    (hp : Incidence p (ProjectiveLine.param i t)) : ∃ q, fiberPlane i t q = p := by
  induction p using Projectivization.ind with
  | h v hv =>
    rw [incidence_mk_iff,← directionVector_mk i t,Projectivization.submodule_mk,
      Submodule.mem_span_singleton] at hp
    obtain ⟨a,ha⟩ := hp
    have he : fiberLinear i t ![v 0,a] = v := by
      ext j
      fin_cases j
      · rfl
      · exact congrFun ha 0
      · exact congrFun ha 1
    have hw : (![v 0,a] : Fin 2 → ℂ) ≠ 0 := by
      intro hz
      apply hv
      rw [← he,hz,map_zero]
    refine ⟨Projectivization.mk ℂ ![v 0,a] hw,?_⟩
    rw [fiberPlane,Projectivization.map_mk]
    exact (Projectivization.mk_eq_mk_iff' ℂ _ _ _ _).mpr ⟨1,by simpa using he.symm⟩

def rulingChart (i : Fin 2) : Set Point := ruling ⁻¹' ProjectiveLine.chartSet i

theorem rulingChart_eq_range (i : Fin 2) : rulingChart i = range (localParam i) := by
  ext q
  constructor
  · rintro ⟨t,ht⟩
    have hi : Incidence (blowdown q) (ProjectiveLine.param i t) := by rw [ht]; exact q.property
    obtain ⟨p,hp⟩ := exists_fiberPlane_of_incidence i t (blowdown q) hi
    exact ⟨(p,t),point_ext hp ht⟩
  · rintro ⟨⟨p,t⟩,rfl⟩
    exact ⟨t,rfl⟩

/-- The true ruling preimage over each standard affine base chart is `P¹ × ℂ`. -/
def localProduct (i : Fin 2) : (Direction × ℂ) ≃ rulingChart i :=
  (Equiv.ofInjective (localParam i) (localParam_injective i)).trans
    (Equiv.setCongr (rulingChart_eq_range i).symm)

@[simp] theorem localProduct_apply (i : Fin 2) (q : Direction × ℂ) :
    (localProduct i q).val = localParam i q := rfl

theorem ruling_charts_cover (q : Point) : ∃ i, q ∈ rulingChart i := by
  obtain ⟨i,t,ht⟩ := ProjectiveLine.charts_cover (ruling q)
  exact ⟨i,t,ht.symm⟩

end
end FailureOfSemipositiveMetricExtension.Hisamoto
