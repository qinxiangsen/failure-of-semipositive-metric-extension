import FailureOfSemipositiveMetricExtension.ProjectivePlaneCharts
import Mathlib.Geometry.Manifold.ChartedSpace
import Mathlib.Analysis.Calculus.ContDiff.Operations

/-!
The actual quotient type for complex projective two-space is given the topology
generated by its three standard affine charts. Every overlap map and every atlas
obligation is proved explicitly, rather than postulated as projective-space background.
-/

noncomputable section

namespace FailureOfSemipositiveMetricExtension.ProjectivePlane

open Set
open scoped ContDiff

/-- Coordinates extended arbitrarily off their chart domain. -/
def coordinates (i : Fin 3) : Point → ℂ × ℂ := Function.invFun (param i)

@[simp] theorem coordinates_param (i : Fin 3) (q : ℂ × ℂ) :
    coordinates i (param i q) = q := Function.leftInverse_invFun (param_injective i) q

theorem param_coordinates (i : Fin 3) (p : Point) (hp : p ∈ chartSet i) :
    param i (coordinates i p) = p := by
  rcases hp with ⟨q,rfl⟩
  rw [coordinates_param]

def partialChart (i : Fin 3) : PartialEquiv Point (ℂ × ℂ) where
  toFun := coordinates i
  invFun := param i
  source := chartSet i
  target := univ
  map_source' _ _ := mem_univ _
  map_target' q _ := ⟨q,rfl⟩
  left_inv' := param_coordinates i
  right_inv' q _ := coordinates_param i q

@[simp] theorem partialChart_source (i : Fin 3) : (partialChart i).source = chartSet i := rfl
@[simp] theorem partialChart_target (i : Fin 3) : (partialChart i).target = univ := rfl
@[simp] theorem partialChart_symm_apply (i : Fin 3) (q : ℂ × ℂ) :
    (partialChart i).symm q = param i q := rfl

theorem coordinates_transition (i j : Fin 3) (q : ℂ × ℂ) (hq : q ∈ overlap i j) :
    coordinates j (param i q) = transition i j q := by
  rw [param_transition i j q hq,coordinates_param]

@[simp] theorem partialChart_transition_source (i j : Fin 3) :
    ((partialChart i).symm.trans (partialChart j)).source = overlap i j := by
  ext q
  simpa [PartialEquiv.trans_source] using param_mem_chartSet_iff i j q

theorem partialChart_transition_apply (i j : Fin 3) (q : ℂ × ℂ)
    (hq : q ∈ overlap i j) :
    ((partialChart i).symm.trans (partialChart j)) q = transition i j q :=
  coordinates_transition i j q hq

/-- All standard overlap domains are open affine subsets. -/
theorem overlap_isOpen (i j : Fin 3) : IsOpen (overlap i j) := by
  fin_cases i <;> fin_cases j <;> simp [overlap,vector]
  all_goals first
    | exact isOpen_ne.preimage continuous_fst
    | exact isOpen_ne.preimage continuous_snd

/-- Every standard projective transition is complex analytic on its true overlap. -/
theorem transition_contDiffOn (i j : Fin 3) (n : WithTop ℕ∞) :
    ContDiffOn ℂ n (transition i j) (overlap i j) := by
  have hA : ContDiffOn ℂ n (fun q : ℂ × ℂ => (q.1⁻¹,q.2/q.1)) {q | q.1 ≠ 0} :=
    (contDiff_fst.contDiffOn.inv (fun _ h => h)).prodMk
      (contDiff_snd.contDiffOn.div contDiff_fst.contDiffOn (fun _ h => h))
  have hB : ContDiffOn ℂ n (fun q : ℂ × ℂ => (q.2⁻¹,q.1/q.2)) {q | q.2 ≠ 0} :=
    (contDiff_snd.contDiffOn.inv (fun _ h => h)).prodMk
      (contDiff_fst.contDiffOn.div contDiff_snd.contDiffOn (fun _ h => h))
  have hC : ContDiffOn ℂ n (fun q : ℂ × ℂ => (q.1/q.2,q.2⁻¹)) {q | q.2 ≠ 0} :=
    (contDiff_fst.contDiffOn.div contDiff_snd.contDiffOn (fun _ h => h)).prodMk
      (contDiff_snd.contDiffOn.inv (fun _ h => h))
  have hD : ContDiffOn ℂ n (fun q : ℂ × ℂ => (q.2/q.1,q.1⁻¹)) {q | q.1 ≠ 0} :=
    (contDiff_snd.contDiffOn.div contDiff_fst.contDiffOn (fun _ h => h)).prodMk
      (contDiff_fst.contDiffOn.inv (fun _ h => h))
  fin_cases i <;> fin_cases j
  · exact contDiffOn_id
  · exact hA
  · exact hB
  · exact hA
  · exact contDiffOn_id
  · exact hC
  · exact hD
  · exact hC
  · exact contDiffOn_id

theorem transition_continuousOn (i j : Fin 3) :
    ContinuousOn (transition i j) (overlap i j) :=
  (transition_contDiffOn i j 0).continuousOn

/-- The three verified affine charts determine a genuine charted-space core. -/
def atlasCore : ChartedSpaceCore (ℂ × ℂ) Point where
  atlas := range partialChart
  chartAt p := partialChart (Classical.choose (charts_cover p))
  mem_chart_source p := by
    obtain ⟨q,hq⟩ := Classical.choose_spec (charts_cover p)
    exact ⟨q,hq.symm⟩
  chart_mem_atlas p := ⟨_,rfl⟩
  open_source e e' he he' := by
    rcases he with ⟨i,rfl⟩
    rcases he' with ⟨j,rfl⟩
    rw [partialChart_transition_source]
    exact overlap_isOpen i j
  continuousOn_toFun e e' he he' := by
    rcases he with ⟨i,rfl⟩
    rcases he' with ⟨j,rfl⟩
    rw [partialChart_transition_source]
    exact (transition_continuousOn i j).congr (partialChart_transition_apply i j)

/-- The standard affine-atlas topology on mathlib's actual projectivization quotient. -/
instance instTopologicalSpacePoint : TopologicalSpace Point := atlasCore.toTopologicalSpace

instance instChartedSpacePoint : ChartedSpace (ℂ × ℂ) Point := atlasCore.toChartedSpace

/-- Each standard chart is a genuine partial homeomorphism. -/
def homeomorphChart (i : Fin 3) : PartialHomeomorph Point (ℂ × ℂ) :=
  atlasCore.partialHomeomorph (partialChart i) ⟨i,rfl⟩

@[simp] theorem homeomorphChart_source (i : Fin 3) :
    (homeomorphChart i).source = chartSet i := rfl
@[simp] theorem homeomorphChart_target (i : Fin 3) :
    (homeomorphChart i).target = univ := rfl
@[simp] theorem homeomorphChart_symm_apply (i : Fin 3) (q : ℂ × ℂ) :
    (homeomorphChart i).symm q = param i q := rfl

theorem chartSet_isOpen (i : Fin 3) : IsOpen (chartSet i) := (homeomorphChart i).open_source

theorem param_continuous (i : Fin 3) : Continuous (param i) :=
  continuous_iff_continuousOn_univ.mpr (homeomorphChart i).continuousOn_symm

theorem param_isOpenEmbedding (i : Fin 3) : Topology.IsOpenEmbedding (param i) :=
  (homeomorphChart i).symm.to_isOpenEmbedding rfl

/-- The three-chart cover proves second countability. -/
instance instSecondCountableTopologyPoint : SecondCountableTopology Point := by
  haveI : ∀ i, SecondCountableTopology (chartSet i) :=
    fun i => (homeomorphChart i).secondCountableTopology_source
  apply TopologicalSpace.secondCountableTopology_of_countable_cover (U := chartSet)
  · exact chartSet_isOpen
  · ext p
    simp only [mem_iUnion,mem_univ,iff_true]
    obtain ⟨i,q,hq⟩ := charts_cover p
    exact ⟨i,q,hq.symm⟩

end FailureOfSemipositiveMetricExtension.ProjectivePlane
