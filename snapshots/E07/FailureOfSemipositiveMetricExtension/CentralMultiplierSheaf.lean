import FailureOfSemipositiveMetricExtension.CentralMultiplierStalks
import FailureOfSemipositiveMetricExtension.GermLocalDivisibility

/-! Actual sheaf equality for the prescribed multiplier ideal. The left side is
built from weighted local-integrability germs, the right from local holomorphic
divisibility by the actual ell section. Both have proved restriction and gluing. -/
namespace FailureOfSemipositiveMetricExtension.GlobalIncidence.FixedFiberBundle
noncomputable section
open Set TopologicalSpace Opposite CategoryTheory Manifold
open scoped Manifold ContDiff

def centralMultiplierIdealSheaf (m : ℕ) : TopCat.Sheaf (Type) (TopCat.of (Fiber 0)) :=
  FailureOfSemipositiveMetricExtension.Multiplier.idealSheaf (Fiber 0) (centralMultiplierStalkIdeal m)

def ellPowerIdealSheaf (k : ℕ) : TopCat.Sheaf (Type) (TopCat.of (Fiber 0)) :=
  FailureOfSemipositiveMetricExtension.Multiplier.idealSheaf (Fiber 0) (ellPowerStalkIdeal k)

/-- The genuine sheaf identity, for every nonnegative integer tensor exponent. -/
theorem centralMultiplierIdealSheaf_eq (m : ℕ) :
    centralMultiplierIdealSheaf m = ellPowerIdealSheaf (m/2) :=
  FailureOfSemipositiveMetricExtension.Multiplier.idealSheaf_eq_of_stalk_ideals (Fiber 0)
    (centralMultiplierStalkIdeal_eq m)

/-- The divisor ideal sheaf is genuinely locally generated by the k-th power
of the actual holomorphic ell equation, with an actual holomorphic quotient. -/
theorem ellIdealSections_locally_principal (k : ℕ) (i : Index)
    (U : Opens (Fiber 0)) (hU : (U : Set (Fiber 0)) ⊆ baseSet 0 i)
    (f : C^∞⟮𝓘(ℂ,FixedFiber.Coord),U;𝓘(ℂ),ℂ⟯) :
    f ∈ FailureOfSemipositiveMetricExtension.Multiplier.idealSections (Fiber 0) (ellPowerStalkIdeal k) U ↔
      ∀ (p : Fiber 0) (hp : p ∈ U),
        ∃ (V : Opens (Fiber 0)) (hpV : p ∈ V) (j : V ⟶ U)
          (a : C^∞⟮𝓘(ℂ,FixedFiber.Coord),V;𝓘(ℂ),ℂ⟯),
          (holomorphicSheaf 0).presheaf.map j.op f =
            (show C^∞⟮𝓘(ℂ,FixedFiber.Coord),V;𝓘(ℂ),ℂ⟯ from
              (holomorphicSheaf 0).presheaf.map j.op (coefficientSectionOn ellSection i U hU))^k * a := by
  have hlocal (p : Fiber 0) (hp : p ∈ U) :
      (holomorphicSheaf 0).presheaf.germ U p hp f ∈ ellPowerStalkIdeal k p ↔
        ∃ (V : Opens (Fiber 0)) (hpV : p ∈ V) (j : V ⟶ U)
          (a : C^∞⟮𝓘(ℂ,FixedFiber.Coord),V;𝓘(ℂ),ℂ⟯),
          (holomorphicSheaf 0).presheaf.map j.op f =
            (show C^∞⟮𝓘(ℂ,FixedFiber.Coord),V;𝓘(ℂ),ℂ⟯ from
              (holomorphicSheaf 0).presheaf.map j.op (coefficientSectionOn ellSection i U hU))^k * a := by
    rw [ellPowerStalkIdeal,divisorPowerStalkIdeal_eq_frame ellSection k i p (hU hp),
      sectionGerm_eq_restrict ellSection i p (hU hp) U hU hp]
    exact FailureOfSemipositiveMetricExtension.Multiplier.germ_mem_power_iff_locally_divisible (Fiber 0)
      U (coefficientSectionOn ellSection i U hU) f p hp k
  constructor
  · intro h p hp
    exact (hlocal p hp).mp (h p hp)
  · intro h p hp
    exact (hlocal p hp).mpr (h p hp)

/-- The actual sigma coefficient is in the genuine fourth-power multiplier ideal. -/
theorem sigmaSection_germ_multiplier (i : Index) (p : Fiber 0) (hp : p ∈ baseSet 0 i) :
    sectionGerm sigmaSection i p hp ∈ centralMultiplierStalkIdeal 4 p := by
  rw [centralMultiplierStalkIdeal_eq]
  exact sigmaSection_germ_mem_ellSquare i p hp

theorem sigmaSection_germ_weighted_integrable (i : Index) (p : Fiber 0)
    (hp : p ∈ baseSet 0 i) :
    FailureOfSemipositiveMetricExtension.Multiplier.IntegrableGerm (Fiber 0) 4 (centralH0.weight i) p
      (sectionGerm sigmaSection i p hp) := by
  rw [centralH0_multiplierGerm_iff 4 i p hp]
  exact sigmaSection_germ_mem_ellSquare i p hp

end
end FailureOfSemipositiveMetricExtension.GlobalIncidence.FixedFiberBundle
